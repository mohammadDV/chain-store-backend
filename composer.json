{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/evryn/laravel-toman"
        }
    ],
    "require": {
        "php": "^8.5",
        "aws/aws-sdk-php": "^3.368.0",
        "cviebrock/eloquent-sluggable": "^13.0",
        "evryn/laravel-toman": "dev-master#1ce7e22eb8951a86e51ac5fac42e973e48c3fa91",
        "filament/filament": "^3.3.55",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^3.11",
        "irazasyed/telegram-bot-sdk": "^3.16",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.49",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.29",
        "morilog/jalali": "^3.4",
        "mpdf/mpdf": "^8.2",
        "spatie/laravel-permission": "^6.25",
        "symfony/http-foundation": "^7.4 || ^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Application\\": "src/Application",
            "Domain\\": "src/Domain",
            "Core\\": "src/Core",
            "Support\\": "src/Support",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
