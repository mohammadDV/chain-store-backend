APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chainstore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Pinned so the cookie name never shifts with APP_NAME or framework defaults.
SESSION_COOKIE=bof_astor_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=bof_astor_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=bof_astor_database_

# Horizon dashboard at /horizon (requires Redis + QUEUE_CONNECTION=redis)
HORIZON_PREFIX=bof_astor_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PRODUCT_SCRAPER_URL=http://127.0.0.1:8001
PRODUCT_SCRAPER_TIMEOUT=180
# PRODUCT_SCRAPER_TOKEN=
# Auto refresh of stale products (scheduled every 15 minutes via cron + Horizon)
PRODUCT_SCRAPER_STALE_REFRESH_ENABLED=true
PRODUCT_SCRAPER_STALE_LIMIT=10
PRODUCT_SCRAPER_STALE_HOURS=48
PRODUCT_SCRAPER_STALE_DELAY_SECONDS=3
PRODUCT_SCRAPER_CART_REFRESH_QUEUE=high
PRODUCT_MIN_ORDER_AMOUNT=50000

# Comma-separated emails that bypass Filament permission and brand checks
ADMIN_SUPER_ADMIN_EMAILS=admin@gmail.com
